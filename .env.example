# dumbdock — environment configuration.
# Copied to .env by `./control.sh setup`. Empty secret-looking keys
# (e.g. DUMBDOCK_PASSWORD) are auto-generated during setup.

DUMBDOCK_PORT=8080
DUMBDOCK_PASSWORD=
DUMBDOCK_AUTH_MODE=none
POLL_INTERVAL=10s

# --- Optional settings (uncomment to use) ---
# AUTO_DETECTION=true
# AUTODETECT_GROUP_NAME=Auto Detected
# AUTO_DETECTION_SERVICE_BLACKLIST=server,db,app
# CONTAINER_BLACKLIST=dumbdock,traefik
# DUMBDOCK_URL=https://dumbdock.example.com
# NTFY_TOPIC=mytopic
# GOTIFY_URL=https://gotify.example.com
# GOTIFY_TOKEN=your-token
# ALERT_COOLDOWN=5m
# TRAEFIK_API_URL=http://traefik:8080
# TRAEFIK_API_TOKEN=your-token
# TRAEFIK_API_USER=user
# TRAEFIK_API_PASS=pass
