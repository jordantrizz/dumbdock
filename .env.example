# dumbdock — environment configuration.
# Copied to .env by `./control.sh setup`. Empty secret-looking keys
# (e.g. DUMBDOCK_PASSWORD) are auto-generated during setup.

DUMBDOCK_PORT=8080
DUMBDOCK_PASSWORD=
# Auth mode: none | http-auth (Basic pop-up) | web-auth (login form).
# Defaults to web-auth; set to none to disable auth.
# Can also be set as "authMode" in dumbdock.json; this env var wins.
# With an auth mode and no DUMBDOCK_PASSWORD, a random password is generated and logged.
DUMBDOCK_AUTH_MODE=web-auth
POLL_INTERVAL=10s

# Directory for persisted runtime state (issue acknowledgements).
# In Docker this is mounted as a named volume; the compose file sets /data.
# DUMBDOCK_STATE_DIR=/data

# --- Storage and backups (Storage tab) ---
# Host conventions checked by the Storage tab. Paths are inside the container,
# so mount /srv/containers read-only at the same path to verify artifacts.
# DUMBDOCK_CONTAINER_ROOT=/opt/containers
# DUMBDOCK_DATA_ROOT=/srv/containers
# DUMBDOCK_BACKUP_ROOT=/srv/containers
# DUMBDOCK_BACKUP_MAX_AGE=26h
# DUMBDOCK_BACKUP_SCAN_INTERVAL=5m
# Token for POST /api/backups/report. Grants report-write only.
# DUMBDOCK_BACKUP_TOKEN=

# --- Optional settings (uncomment to use) ---
# AUTO_DETECTION=true
# AUTODETECT_GROUP_NAME=Auto Detected
# AUTO_DETECTION_SERVICE_BLACKLIST=server,db,app
# CONTAINER_BLACKLIST=dumbdock,traefik
# DUMBDOCK_UPDATE_CHECK=true
# DUMBDOCK_UPDATE_INTERVAL=6h
# DUMBDOCK_URL=https://dumbdock.example.com
# NTFY_TOPIC=mytopic
# GOTIFY_URL=https://gotify.example.com
# GOTIFY_TOKEN=your-token
# ALERT_COOLDOWN=5m
# TRAEFIK_API_URL=http://traefik:8080
# TRAEFIK_API_TOKEN=your-token
# TRAEFIK_API_USER=user
# TRAEFIK_API_PASS=pass
