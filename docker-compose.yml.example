services:
  dumbdock:
    build: .
    container_name: dumbdock
    restart: unless-stopped
    ports:
      # Host port (DUMBDOCK_PORT) -> container port 8080. DUMBDOCK_PORT is the
      # published host port only; the app listens on 8080 inside the container.
      - "127.0.0.1:${DUMBDOCK_PORT:-8080}:8080"
    environment:
      - POLL_INTERVAL=${POLL_INTERVAL:-10s}
      # Auth mode: none (open) | http-auth (HTTP Basic) | web-auth (login form + session cookie).
      # Overrides "authMode" in dumbdock.json. Defaults to web-auth; set to none to
      # disable auth. With an auth mode and no DUMBDOCK_PASSWORD, a random password is
      # generated and logged. See README "Authentication".
      - DUMBDOCK_AUTH_MODE=${DUMBDOCK_AUTH_MODE:-web-auth}
      - DUMBDOCK_PASSWORD=${DUMBDOCK_PASSWORD:-} # enables auth for the http-auth/web-auth modes
      # - AUTO_DETECTION=true                            # enable/disable auto-detection
      # - AUTODETECT_GROUP_NAME=Auto Detected            # name for the auto-detected group
      # - AUTO_DETECTION_SERVICE_BLACKLIST=server,db,app # skip service-name-based icon matching for generic names
      # - CONTAINER_BLACKLIST=dumbdock,traefik           # hide specific containers from the dashboard
      # - DUMBDOCK_UPDATE_CHECK=true                    # check registries for newer image tags (default: true)
      # - DUMBDOCK_UPDATE_INTERVAL=6h                   # how often each image tag is re-checked
      # - DUMBDOCK_URL=https://dumbdock.example.com      # public URL for alert links
      # - NTFY_TOPIC=mytopic                             # ntfy alert notifications
      # - GOTIFY_URL=https://gotify.example.com          # Gotify alert server
      # - GOTIFY_TOKEN=your-token                        # Gotify app token
      # - ALERT_COOLDOWN=5m                              # min time between alerts
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # - ./dumbdock.json:/config/dumbdock.json:ro     # override config (supports iconSets)
      # - ./my-icons/:/config/my-icons/:ro             # local icon index files
    healthcheck:
      # Pure TCP liveness: confirms the app is listening on its in-container port.
      # 127.0.0.1 avoids DNS; 8080 is the fixed in-container listen port.
      # No HTTP route or auth involved. Requires the alpine runtime base (nc).
      test: ["CMD", "nc", "-z", "-w", "2", "127.0.0.1", "8080"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

# Dependency grouping: dumbdock reads the com.docker.compose.depends_on label
# that Compose sets automatically. In the dashboard, switch the nav toggle to
# "By Dependency" to group containers under the container(s) they depend on.
# Example:
#
# services:
#   db:
#     image: postgres:16
#   app:
#     image: myapp
#     depends_on:
#       - db
#
# The "app" container then appears under a "db" group heading in the
# By Dependency view.
